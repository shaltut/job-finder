# Copy to .env (which is gitignored) and fill in.

# Required: the scoring model reads your CV and scores each scraped post.
OPENAI_API_KEY=sk-...

# Optional overrides.
# JOBFINDER_DB=data/jobfinder.db      # SQLite file; the Nitro server is its only writer
# JOBFINDER_MODEL=gpt-5-nano          # scoring model
# PROFILE_DIR=profile                 # the scraper's own logged-in Chrome profile

# Model for Settings -> Generate from CV. Defaults to gpt-5-mini and should stay at least that
# capable: gpt-5-nano returns an EMPTY requirements table for this prompt, which is schema-valid, so
# the generated background silently comes back with no gaps at all.
# JOBFINDER_BACKGROUND_MODEL=gpt-5-mini
